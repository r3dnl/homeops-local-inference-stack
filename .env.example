# Copy to .env and fill in. Both `docker compose` and `setup.sh` read this file.

# --- Engine selection (NInfer default; Infernix switchable) ---
#
# Which engine serves the endpoint: `ninfer` (the purpose-built C++/CUDA
# engine, serves Qwen3.8-27B NVFP4, default) or `infernix` (serves a
# DIFFERENT model — Qwen3.8-Flash-Next, a 125B MoE, in the .infernix +
# ngram format; its model is a one-time manual download, see the Infernix
# section below). docker compose starts the services of the selected
# profile (see docker-compose.yml). Switch with `./switch.sh ninfer` /
# `./switch.sh infernix` (flips this line, tears the stack down, brings it
# back up on the other engine, smoke tests).
COMPOSE_PROFILES=ninfer

# --- NInfer (COMPOSE_PROFILES=ninfer) ---

# Bearer / x-api-key value for the NInfer OpenAI-compatible API (works as
# `Authorization: Bearer <key>` on the OpenAI routes or as the Anthropic-style
# `x-api-key` header). Leave empty to run without authentication
# (local networks only!).
NINFER_API_KEY=

# NInfer performance profile (serve flags in docker-compose.yml): the shipped
# default is the dedicated-card max-performance tuning — full 256K context
# (262144), 8 active lanes (the engine's cap), FP8 KV, MTP3 speculative
# decode + optimized proposal head. It assumes a dedicated card (nothing
# else on the GPU: no display output, no other GPU workloads — check the
# card is idle via `nvidia-smi`). Deviate only when needed — e.g. run on a
# shared host with fewer lanes (more KV headroom per request):
#   NINFER_MAX_CONCURRENCY=2
#   NINFER_MAX_CONTEXT=240000
# All keys keep the shipped values when unset or empty.
#NINFER_MAX_CONTEXT=262144
#NINFER_MAX_CONCURRENCY=8
#NINFER_KV_DTYPE=fp8
#NINFER_DRAFT_TOKENS=3

# Build context for the NInfer runtime image. House convention: engine
# source is a third-party clone and lives under ~/repos — set the absolute
# path (unset, compose falls back to a sibling checkout ../ninfer).
#NINFER_BUILD_DIR=/home/YOU/repos/ninfer

# --- Infernix (COMPOSE_PROFILES=infernix) ---

# Serves Qwen3.8-Flash-Next in the NVIDIA NVFP4 Dense8 conversion
# (3 shards) + a shared ~52 GB n-gram volume. Its model is a one-time
# manual download to the paths below (NOT fetched by setup.sh), so a switch
# to it never re-downloads. Build context for the runtime image — same
# convention, a clone under ~/repos with an absolute path (unset, compose
# falls back to a sibling checkout ../Infernix):
#INFERNIX_BUILD_DIR=/home/YOU/repos/Infernix

# Host dirs holding the Flash-Next model, mounted read-only at /models.
# Point these at wherever your NVMe/ZFS store keeps the download. The
# n-gram dir must exist as <models dir>/ngram even when empty (see the
# docker-compose.yml comment — a missing mountpoint dir fails the container).
#INFERX_MODELS_DIR=/mnt/zdata/ai-models/infernix
#INFERX_NGRAM_DIR=/mnt/zdata/ai-models/ngram

# Serve-flag overrides (the infernix service's command in docker-compose.yml).
# Shipped defaults: Qwen3.8-Flash-Next, full 256K context, C=8, int8 KV, MTP
# drafting. All keys keep the shipped values when unset or empty.
#   INFERX_ARTIFACT          which .infernix shard to load (part 1 of the split)
#   INFERX_NGRAM_VOLUME      the .ngram path ("" to omit)
#   INFERX_MODEL_ID          --model-id (default qwen3.8-flash-next)
#   INFERX_MAX_CONTEXT       --max-context (default 262144)
#   INFERX_KV_CAPACITY       --kv-capacity, tokens across all lanes (default 524288)
#   INFERX_MAX_CONCURRENCY   --max-concurrency, 1-8 (default 8)
#   INFERX_KV_DTYPE          --kv-dtype (default int8; nvfp4 frees more VRAM)
#   INFERX_RAM_HEADROOM_MIB  --ram-headroom-mib host RAM to leave free
#                              (default 8192; do not go below 8192 on a desktop host)
#INFERX_ARTIFACT=Qwen3.8-Flash-Next-NVIDIA-NVFP4-Dense8-Infernix-00001-of-00003.infernix
#INFERX_NGRAM_VOLUME=Qwen3.8-Flash-Next-NVIDIA-NVFP4-Infernix.ngram
#INFERX_MODEL_ID=qwen3.8-flash-next
#INFERX_MAX_CONTEXT=262144
#INFERX_KV_CAPACITY=524288
#INFERX_MAX_CONCURRENCY=8
#INFERX_KV_DTYPE=int8
#INFERX_RAM_HEADROOM_MIB=8192

# --- Shared (both engines) ---

# Host port for the direct OpenAI-compatible API (unset = default 8020).
# The container-side port is fixed (8080) — only the host mapping changes.
# Both engines publish 8020 by default, so clients don't notice a switch.
#NINFER_HOST_PORT=8020

# Model selection (all optional — unset keys keep the defaults for the stock
# Qwen3.8-27B NVFP4 model). Uncomment and adjust to switch models.
#MODEL_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090   # tokenizer files source
#MODEL_SUBDIR=qwen3.8-27b-nvfp4
#SERVED_MODEL_NAME=qwen3.8-27b
# CONTAINER_NAME names the engine service (only one engine runs at a time).
#CONTAINER_NAME=ninfer
#NINFER_ARTIFACT=qwen3_8_27b_nvfp4.ninfer

# The NInfer engine artifact (single .ninfer file, ~17 GB: weights,
# bindings, tokenizer, chat template, MTP companion weights) is pinned to a
# known-good revision of neroued/Qwen3.8-27B-nvfp4-NInfer (the default in
# setup.sh). Set to another revision sha to fetch that state, or to an empty
# string to always track the latest artifact.
#NINFER_REVISION=a107ba1b5b0609d9ca90d5ed61439f5f5cc7d64d

# The tokenizer files under ./models/ (setup.sh downloads them for the bench
# suite's token-accurate padding) are pinned to a known-good Hugging Face
# revision (the default in setup.sh). Same semantics as NINFER_REVISION.
#MODEL_REVISION=0cc27958cefbbe231782ec8511de8c4eb5233348

# --- Benchmark service (ninfer profile) ---

# Host port for the headless bench control API (loopback-only, default 8040).
# Per-request client timeout for bench runs (default 600 s).
#BENCH_HOST_PORT=8040
#BENCH_TIMEOUT_S=600
